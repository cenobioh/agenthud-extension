{
  "name": "agenthud",
  "displayName": "AgentHUD",
  "description": "Status HUD and focus router for AI agents running in native terminal tabs",
  "version": "0.0.2",
  "publisher": "cenobioh",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cenobioh/agenthud-extension.git"
  },
  "keywords": [
    "agent",
    "terminal",
    "hud",
    "status",
    "ai"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:agenthud.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agenthud",
          "title": "Agent HUD",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "agenthud": [
        {
          "id": "agenthud.sidebar",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish:openvsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.32.0",
    "ovsx": "^0.9.5",
    "typescript": "^5.4.0"
  }
}
