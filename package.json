{
  "name": "agenthud",
  "displayName": "AgentHUD",
  "description": "Status HUD and focus router for AI agents running in native terminal tabs",
  "version": "0.0.5",
  "publisher": "cenobioh",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cenobioh/agenthud-extension.git"
  },
  "keywords": [
    "agent",
    "terminal",
    "hud",
    "status",
    "ai"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:agenthud.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agenthud",
          "title": "Agent HUD",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "agenthud": [
        {
          "id": "agenthud.sidebar",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "AgentHUD",
      "properties": {
        "agenthud.defaultSessionsDirectory": {
          "type": "string",
          "default": "",
          "description": "Default parent directory suggested when starting a new AgentHUD session. Leave empty to default to your home directory."
        },
        "agenthud.port": {
          "type": "number",
          "default": 4545,
          "description": "Port the local IPC server binds to on 127.0.0.1. Change this if 4545 conflicts with another AgentHUD instance (e.g. a second window/profile)."
        },
        "agenthud.stuckThresholdMinutes": {
          "type": "number",
          "default": 10,
          "description": "Flag a WORKING session as possibly stuck if it hasn't reported a status update in this many minutes."
        }
      }
    },
    "commands": [
      {
        "command": "agenthud.focusNextDecision",
        "title": "AgentHUD: Focus Next Decision"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish:openvsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.32.0",
    "ovsx": "^0.9.5",
    "typescript": "^5.4.0"
  }
}
