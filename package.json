{
  "name": "agenthud",
  "displayName": "AgentHUD",
  "description": "Status HUD and focus router for AI agents running in native terminal tabs",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onView:agenthud.sidebar"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agenthud",
          "title": "Agent HUD",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "agenthud": [
        {
          "id": "agenthud.sidebar",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
